{
  "name": "api-nodetest",
  "version": "1.4.0",
  "description": "The Neotoma API: Connecting users to the Neotoma database through Express.js",
  "keywords": [
    "api",
    "paleoecology",
    "neotoma"
  ],
  "repository": "https://github.com/NeotomaDB/api_nodetest",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "NODE_ENV=production nodemon --legacy-watch app.js",
    "test": "node ./node_modules/mocha/bin/mocha --config=test/.mocharc.yml --reporter-options reportDir=public,reportFilename=tests",
    "build:openapi": "(cd ./openapi && node ./scripts/build-openapi.js)",
    "validate:openapi": "yarn build:openapi && bash genoatt.sh && sleep 4 && bash runmochabatch.sh"
  },
  "pre-commit": "validate:openapi",
  "dependencies": {
    "@terraformer/wkt": "^2.2.1",
    "acorn": "^8.15.0",
    "apicache": "^1.6.2",
    "axios": "^1.12.0",
    "big-json": "^3.2.0",
    "bluebird": "^3.7.2",
    "body-parser": "^1.20.3",
    "chakram": "^1.5.0",
    "child-process-promise": "^2.2.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv": "^6.4.1",
    "csv-transform": "^0.0.8",
    "dotenv": "^8.6.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "he": "^1.2.0",
    "helmet": "^8.1.0",
    "jade": "^1.11.0",
    "js2xmlparser": "^4.0.1",
    "morgan": "^1.10.1",
    "node-postgres": "^0.6.2",
    "oatts": "^1.6.0",
    "object-sizeof": "^1.6.3",
    "pg-promise": "^11.15.0",
    "request": "^2.88.2",
    "rotating-file-stream": "^2.1.5",
    "swagger-ui-express": "^4.3.0",
    "terraformer": "^1.0.12",
    "terraformer-wkt-parser": "^1.2.1",
    "xmlcreate": "^2.0.3",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "chai": "^4.3.6",
    "chai-openapi-response-validator": "^0.14.2",
    "eslint": "^9.39.2",
    "eslint-config-google": "^0.11.0",
    "eslint-config-standard": "^12.0.0",
    "eslint-config-strongloop": "^2.1.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-node": "^7.0.1",
    "eslint-plugin-promise": "^4.3.1",
    "eslint-plugin-standard": "^4.1.0",
    "gulp": "^5.0.0",
    "gulp-mocha": "^10.0.0",
    "gulp-nodemon": "^2.2.1",
    "mocha": "^11.7.1",
    "mochawesome": "^7.1.3",
    "nodemon": "^3.1.4",
    "pre-commit": "^1.0.10",
    "supertest": "^3.4.2"
  }
}
